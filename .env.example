# Example environment variables
# REQUESTTOOL_LOG_LEVEL=info

# Runtime profile
# development: SQLite + auto migrate can stay enabled
# test: isolated SQLite/PostgreSQL, usually auto migrate enabled
# production: PostgreSQL required, auto migrate must be disabled
EAZYTEST_DEPLOYMENT_ENV=development
EAZYTEST_APP_NAME=Eazy Test Web
EAZYTEST_APP_VERSION=0.1.0
EAZYTEST_API_PREFIX=/api/v1
EAZYTEST_LOG_LEVEL=INFO

# Database
EAZYTEST_DATABASE_URL=sqlite:///./web_eazytest.db
EAZYTEST_DATABASE_AUTO_MIGRATE=true

# Reports / shared runtime
EAZYTEST_REPORT_DIR=web_runs
EAZYTEST_REPORT_TEMPLATE_PATH=src/requesttool/shared/assets/report.html

# Auth / user policy
EAZYTEST_AUTH_TOKEN_TTL_HOURS=12
EAZYTEST_AUTH_MAX_ACTIVE_TOKENS_PER_USER=5
EAZYTEST_USER_PASSWORD_MIN_LENGTH=12

# Execution reliability
EAZYTEST_EXECUTION_REQUEST_TIMEOUT_SECONDS=20
EAZYTEST_EXECUTION_RETRY_LIMIT=1
EAZYTEST_EXECUTION_STALE_TIMEOUT_SECONDS=900

# Bootstrap admin
# Keep disabled in shared or production environments.
EAZYTEST_BOOTSTRAP_ADMIN_ENABLED=false
EAZYTEST_BOOTSTRAP_ADMIN_USERNAME=
EAZYTEST_BOOTSTRAP_ADMIN_PASSWORD=

# Worker
EAZYTEST_WORKER_POLL_INTERVAL_SECONDS=2.0

# Scheduler
EAZYTEST_SCHEDULER_POLL_INTERVAL_SECONDS=5.0
EAZYTEST_SCHEDULER_BATCH_SIZE=20

# Legacy compatibility exit strategy
# Keep enabled only while desktop/Excel migration is still active.
EAZYTEST_LEGACY_IMPORTS_ENABLED=true
# Optional: schedule the retirement date for legacy imports.
# Example: EAZYTEST_LEGACY_IMPORTS_SUNSET_DATE=2026-12-31
EAZYTEST_LEGACY_IMPORTS_SUNSET_DATE=

# AI case generation
DATATEST_AI_PROVIDER=openai_compatible
DATATEST_AI_ENDPOINT=
DATATEST_AI_MODEL=
DATATEST_AI_TIMEOUT_SECONDS=60
DATATEST_AI_USE_ENV_PROXY=false
OPENAI_API_KEY=
