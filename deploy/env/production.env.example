EAZYTEST_DEPLOYMENT_ENV=production
EAZYTEST_APP_NAME=Eazy Test Web
EAZYTEST_APP_VERSION=0.1.0
EAZYTEST_API_PREFIX=/api/v1
EAZYTEST_DATABASE_AUTO_MIGRATE=false
EAZYTEST_REPORT_DIR=/var/lib/eazytest/reports
EAZYTEST_REPORT_TEMPLATE_PATH=src/requesttool/shared/assets/report.html
EAZYTEST_AUTH_TOKEN_TTL_HOURS=12
EAZYTEST_AUTH_MAX_ACTIVE_TOKENS_PER_USER=5
EAZYTEST_USER_PASSWORD_MIN_LENGTH=12
EAZYTEST_BOOTSTRAP_ADMIN_ENABLED=false
EAZYTEST_WORKER_POLL_INTERVAL_SECONDS=2.0
